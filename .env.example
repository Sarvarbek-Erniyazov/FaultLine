# Copy to .env (git-ignored) and fill in. Never commit .env.

# Hugging Face access token. Not needed for the M0 Zenodo downloads (unauthenticated);
# wired through python-dotenv for the M2 text corpora.
HF_TOKEN=

# Root directory for the four data stages. Defaults to <repo>/data when unset.
# Point this at another drive if the repo drive is small, e.g. D:/FaultLineData
FAULTLINE_DATA_ROOT=
