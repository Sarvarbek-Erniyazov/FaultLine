# Lesson 11 API settings. No secrets: nothing here is a credential.
# Origins allowed to call the API from a browser, comma-separated (the UI's origin).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Where the exported model, the two tokenizer JSONs and the demo bundle are.
FAULTLINE_MODEL=checkpoints/model.pt
FAULTLINE_TOKENIZERS=data/tokenizers
FAULTLINE_BUNDLE=lesson11/demo/kelmarsh_demo_v0.npz
# Shown by GET /health; the Docker build passes it as a build argument.
FAULTLINE_GIT_SHA=
# Port uvicorn listens on inside the container.
PORT=8000
